<script>
  const menuBtn = document.getElementById('menu-btn');
  const overlay = document.getElementById('mobile-overlay');
  const line1 = document.getElementById('line-1');
  const line2 = document.getElementById('line-2');
  const links = document.querySelectorAll('.mobile-link');

  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;
    
    if (isOpen) {
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      
      setTimeout(() => {
        overlay.classList.add('opacity-100');
        line1.style.transform = 'translateY(4px) rotate(45deg)';
        line2.style.transform = 'translateY(-4px) rotate(-45deg)';
        line1.style.backgroundColor = '#ffffff';
        line2.style.backgroundColor = '#ffffff';
        
        links.forEach((link, i) => {
          setTimeout(() => {
            link.classList.remove('opacity-0', 'translate-y-10');
            link.classList.add('opacity-100', 'translate-y-0');
          }, i * 120);
        });
      }, 50);
      document.body.style.overflow = 'hidden';
    } else {
      overlay.classList.remove('opacity-100');
      line1.style.transform = 'none';
      line2.style.transform = 'none';
      line1.style.backgroundColor = '#0f172a';
      line2.style.backgroundColor = '#0f172a';
      
      links.forEach(link => {
        link.classList.add('opacity-0', 'translate-y-10');
        link.classList.remove('opacity-100', 'translate-y-0');
      });

      setTimeout(() => {
        overlay.classList.replace('flex', 'hidden');
        document.body.style.overflow = '';
      }, 500);
    }
  }

  menuBtn?.addEventListener('click', toggleMenu);

  links.forEach(link => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      toggleMenu();
      
      if (href && href.startsWith('#')) {
        e.preventDefault();
        const targetId = href.replace('#', '');
        setTimeout(() => {
          const target = document.getElementById(targetId);
          if (target) {
            const offset = 80;
            const elementPosition = target.getBoundingClientRect().top + window.pageYOffset;
            window.scrollTo({
              top: elementPosition - offset,
              behavior: 'smooth'
            });
          }
        }, 550);
      }
    });
  });
</script>

